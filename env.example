# Names only - NO values. Real values live in the server's secrets, never in git.
# T-Bank terminal (empty = T-Bank is off entirely, every flag below is ignored)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# Where new payments go. Order of priority: FORCE list -> PAYMENT_PROVIDER=tbank -> ROLLOUT percent -> YooKassa
PAYMENT_PROVIDER=yookassa
TBANK_ROLLOUT_PERCENT=0
TBANK_FORCE_USER_IDS=

# Public URLs (set your own domain)
TBANK_NOTIFICATION_URL=https://<your-domain>/api/v1/payments/tbank/notify
TBANK_RETURN_URL=https://<your-domain>/api/v1/miniapp/pay-return
TBANK_API_BASE=https://securepay.tinkoff.ru/v2

# Receipts (54-FZ) are not sent for a self-employed seller
TBANK_SEND_RECEIPT=false

# Mini App sheet / bots
TBANK_BUTTONS=true
TBANK_EMBED=true
TBANK_BOT_BUTTONS=false
MINIAPP_PAYWALL_INAPP=false
MINIAPP_RETURN_ORIGINS=

# STAGING ONLY (test terminal). Never on production.
TBANK_TEST_MODE=false
TBANK_TEST_USER_IDS=
TBANK_WALLETS_ASSUME=
TBANK_CA_BUNDLE=

BRAND_NAME=
